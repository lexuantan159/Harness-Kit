JIRA_TOKEN=
JIRA_EMAIL=
JIRA_PROJECT_KEY=

# --- Git hosting
GITHUB_TOKEN=
GITLAB_BASE_URL=
GITLAB_TOKEN=
BITBUCKET_BASE_URL=
BITBUCKET_TOKEN=

# --- Notifications (used by mcp/teams_server.py)
TEAMS_WEBHOOK_URL=
